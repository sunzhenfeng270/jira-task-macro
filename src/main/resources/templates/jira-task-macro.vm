#requireResource("com.tangzhi.confluence.jira-task-macro:jira-task-resources")
<div class="jira-task-macro"
     data-page-id="$pageId"
     data-page-title="$pageTitle"
     data-default-project="$projectKey"
     data-default-issue-type="$issueTypeName"
     data-summary-prefix="$summaryPrefix"
     data-labels="$labels"
     data-i18n-head="$texts.head"
     data-i18n-loading="$texts.loading"
     data-i18n-label-project="$texts.labelProject"
     data-i18n-label-issue-type="$texts.labelIssueType"
     data-i18n-label-summary="$texts.labelSummary"
     data-i18n-label-description="$texts.labelDescription"
     data-i18n-label-due-date="$texts.labelDueDate"
     data-i18n-label-priority="$texts.labelPriority"
     data-i18n-label-assignee="$texts.labelAssignee"
     data-i18n-placeholder-summary="$texts.placeholderSummary"
     data-i18n-placeholder-description="$texts.placeholderDescription"
     data-i18n-placeholder-assignee="$texts.placeholderAssignee"
     data-i18n-priority-default="$texts.priorityDefault"
     data-i18n-search="$texts.search"
     data-i18n-create="$texts.create"
     data-i18n-creating="$texts.creating"
     data-i18n-created="$texts.created"
     data-i18n-remove="$texts.remove"
     data-i18n-select-first="$texts.selectFirst"
     data-i18n-select="$texts.select"
     data-i18n-load-failed="$texts.loadFailed"
     data-i18n-related-title="$texts.relatedTitle"
     data-i18n-related-truncated="$texts.relatedTruncated"
     data-i18n-due="$texts.due"
     data-i18n-error-required="$texts.errorRequired"
     data-i18n-error-projects="$texts.errorProjects"
     data-i18n-error-issue-types="$texts.errorIssueTypes"
     data-i18n-error-users="$texts.errorUsers"
     data-i18n-error-create="$texts.errorCreate"
     data-i18n-error-related="$texts.errorRelated"
     data-i18n-error-unsaved="$texts.errorUnsaved">
    <div class="jt-loading">$texts.loading</div>
</div>
