#if($showTitle)
<div style="font-family:Arial,Helvetica,sans-serif;color:#172b4d;font-size:14px;font-weight:bold;margin:0 0 6px 0;">
    $title#if($total > 0)（共 $total 条，显示 $shown 条）#end
</div>
#end

#if($error != "")
<div style="font-family:Arial,Helvetica,sans-serif;border:1px solid #ffbdad;background:#ffebe6;color:#bf2600;padding:8px 10px;font-size:13px;">
    $error
</div>
#elseif($rows.size() == 0)
<table style="border-collapse:collapse;width:100%;font-size:13px;font-family:Arial,Helvetica,sans-serif;">
    <tbody>
    <tr>
        <td style="border:1px solid #cccccc;padding:8px;color:#6b778c;">没有符合条件的 Jira 任务</td>
    </tr>
    </tbody>
</table>
#else
<table style="border-collapse:collapse;width:100%;font-size:13px;color:#172b4d;font-family:Arial,Helvetica,sans-serif;table-layout:fixed;">
    <thead>
    <tr>
        #foreach($col in $columns)
        <th style="border:1px solid #cccccc;background:#f4f5f7;padding:6px 8px;text-align:left;font-weight:bold;">$col.label</th>
        #end
    </tr>
    </thead>
    <tbody>
    #foreach($row in $rows)
    <tr>
        #foreach($cell in $row.cells)
        <td style="border:1px solid #cccccc;padding:6px 8px;vertical-align:top;">
            #if($cell.link.length() > 0)<a href="$cell.link" style="color:#0052cc;text-decoration:none;">$cell.text</a>#else$cell.text#end
        </td>
        #end
    </tr>
    #end
    </tbody>
</table>
#end
